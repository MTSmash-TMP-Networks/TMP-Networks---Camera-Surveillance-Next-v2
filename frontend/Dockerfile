FROM node:24.18.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund || (rm -rf node_modules && npm cache clean --force && npm ci --no-audit --no-fund)
COPY . .
ARG VITE_DEFAULT_LANGUAGE=auto
ARG VITE_VENDOR_URL=https://tmp-networks.de
ARG VITE_SUPPORT_URL=
ARG VITE_DOCUMENTATION_URL=
ARG VITE_STREAM_BROWSER_PREWARM_ENABLED=false
ARG VITE_BROWSER_TRANSCODE_FALLBACK_ENABLED=false
ARG VITE_STREAM_BROWSER_CACHE_SECONDS=120
ARG VITE_HLS_RECOVERY_ESCALATION_SECONDS=10
ENV VITE_DEFAULT_LANGUAGE=$VITE_DEFAULT_LANGUAGE \
    VITE_VENDOR_URL=$VITE_VENDOR_URL \
    VITE_SUPPORT_URL=$VITE_SUPPORT_URL \
    VITE_DOCUMENTATION_URL=$VITE_DOCUMENTATION_URL \
    VITE_STREAM_BROWSER_PREWARM_ENABLED=$VITE_STREAM_BROWSER_PREWARM_ENABLED \
    VITE_BROWSER_TRANSCODE_FALLBACK_ENABLED=$VITE_BROWSER_TRANSCODE_FALLBACK_ENABLED \
    VITE_STREAM_BROWSER_CACHE_SECONDS=$VITE_STREAM_BROWSER_CACHE_SECONDS \
    VITE_HLS_RECOVERY_ESCALATION_SECONDS=$VITE_HLS_RECOVERY_ESCALATION_SECONDS
RUN npm run build

FROM nginx:1.29.8-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=4 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
