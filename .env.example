TZ=Europe/Berlin
PUID=1000
PGID=1000

# Public marketplace / sales demo mode. When enabled, the backend blocks
# configuration changes and security-sensitive actions server-side.
# Evidence ZIP exports are intentionally disabled by default in demo mode.
# Absoluter Pfad des entpackten Projektordners. start.sh setzt diesen Wert automatisch.
PROJECT_HOST_PATH=/opt/tmp-camera-surveillance-next
# Muss bei bestehenden Installationen dem laufenden Compose-Projekt entsprechen.
COMPOSE_PROJECT_NAME=tmp-camera-surveillance-next
ADMIN_USER=admin
ADMIN_PASSWORD=BITTE_AENDERN
JWT_SECRET=MINDESTENS_32_ZUFAELLIGE_ZEICHEN
MEDIA_TOKEN_SECRET=MINDESTENS_32_ZUFAELLIGE_ZEICHEN
CAMERA_CREDENTIAL_KEY=MINDESTENS_32_ZUFAELLIGE_ZEICHEN
UPDATER_TOKEN=MINDESTENS_32_ZUFAELLIGE_ZEICHEN



# Updater backup storage. Primary backup path stays compatible; fallback is used if host permissions block /data/backups.
BACKUPS_DIR=/data/backups
BACKUPS_FALLBACK_DIR=/data/updates/backups
MAX_UPDATE_BYTES=536870912
MAX_EXTRACTED_BYTES=2147483648
ACCESS_TOKEN_TTL=8h
MEDIA_TOKEN_TTL_SECONDS=3600
RECORDING_TOKEN_TTL_SECONDS=86400
STREAM_IDLE_SECONDS=180
PERMANENT_CAMERA_INGEST_ENABLED=true
PERMANENT_CAMERA_INGEST_QUALITY=low
# auto-substream waehlt bevorzugt das kleinste geeignete ONVIF-Profil; camera-preferred respektiert die manuelle Kameravorgabe.
PERMANENT_CAMERA_INGEST_PROFILE=auto-substream
# Dauer-Ingest wird ohne Video-Neukodierung durchgereicht. Audio bleibt aktiv (Opus fuer WebRTC, AAC fuer HLS).
PERMANENT_CAMERA_INGEST_VIDEO_MODE=force-copy
PERMANENT_CAMERA_INGEST_STARTUP_STAGGER_MS=1500
KIOSK_PREFER_SUBSTREAM=true
LIVE_PREFER_MAINSTREAM=true
RECORDING_PREFER_MAINSTREAM=true
MOTION_PREFER_SUBSTREAM=true
BROWSER_TRANSCODE_FALLBACK_ENABLED=false

# Systemstatus (CPU, RAM, Aufnahmespeicher und optionale GPU-Telemetrie)
SYSTEM_METRICS_CACHE_MS=2000
SYSTEM_METRICS_REFRESH_MS=3000
SYSTEM_METRICS_CPU_SAMPLE_MS=250
SYSTEM_METRICS_COMMAND_TIMEOUT_MS=2500
SYSTEM_PROC_ROOT=/host/proc
SYSTEM_SYS_ROOT=/host/sys
SYSTEM_DISK_PATH=/data
SYSTEM_STORAGE_PLAUSIBLE_MAX_BYTES=70368744177664
SYSTEM_HOST_DISK_TOTAL_BYTES=0
SYSTEM_HOST_DISK_USED_BYTES=0
SYSTEM_HOST_DISK_AVAILABLE_BYTES=0
SYSTEM_HOST_DISK_SOURCE=
SYSTEM_NETWORK_EXCLUDE_INTERFACES=lo,docker*,br-*,veth*,virbr*,cni*,podman*
SYSTEM_NETWORK_MAX_DEVICES=12
NVIDIA_SMI_PATH=nvidia-smi
# Nur aktivieren, wenn NVIDIA Container Toolkit auf dem Docker-Host eingerichtet ist.
ENABLE_NVIDIA_GPU_STATUS=false
ENABLE_NVIDIA_GPU_COMPOSE=false
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=utility,compute,video

# Camera discovery jobs and first-start scan
DISCOVERY_JOB_RETENTION_MS=900000
DISCOVERY_MAX_JOBS=30
DISCOVERY_PROTOCOL_RETRIES=1
DISCOVERY_RETRY_DELAY_MS=350
DISCOVERY_SCAN_CONCURRENCY=64
DISCOVERY_PER_HOST_CONCURRENCY=4
DISCOVERY_FINGERPRINT_CONCURRENCY=8
DISCOVERY_PORT_TIMEOUT_MS=600
DISCOVERY_AUTO_TIMEOUT_MS=6500
# auto: nmap nutzen, wenn verfügbar; internal: nur eingebauter TCP-Scanner; nmap: Nmap bevorzugen
DISCOVERY_SCAN_ENGINE=auto
DISCOVERY_NMAP_PATH=nmap
DISCOVERY_NMAP_TIMEOUT_MS=120000
DISCOVERY_HOST_DISCOVERY_PORTS=80,443,554,8000,8080,8443,8554,8899,10554,37777,34567,7681
DISCOVERY_HOST_DISCOVERY_TIMEOUT_MS=350
DISCOVERY_FULL_SCAN_FALLBACK_HOST_LIMIT=32
# Ab dieser Anzahl einzelner /32-Hostrouten im selben /24 wird automatisch zum /24 verdichtet. 0 deaktiviert die Verdichtung.
DISCOVERY_AUTO_HOST_COLLAPSE_THRESHOLD=8
DISCOVERY_INITIAL_ENABLED=true
DISCOVERY_INITIAL_DELAY_MS=3500
DISCOVERY_INITIAL_ATTEMPTS=3
DISCOVERY_INITIAL_RETRY_DELAY_MS=5000
# Startsuche bewusst ressourcenschonend; manuelle Suche und IP-Pruefung bleiben reaktionsschnell.
DISCOVERY_INITIAL_SCAN_CONCURRENCY=16
DISCOVERY_INITIAL_PER_HOST_CONCURRENCY=1
DISCOVERY_INITIAL_FINGERPRINT_CONCURRENCY=2

# Browser stream continuity and recording fault tolerance
STREAM_LEASE_TTL_SECONDS=90
STREAM_BROWSER_CACHE_SECONDS=120
# Aufnahmen werden als atomare, einzeln abspielbare Blöcke gespeichert.
RECORDING_BLOCK_SECONDS=300
RECORDING_BLOCK_PROBE_TIMEOUT_MS=12000
RECORDING_BLOCK_MINIMUM_BYTES=1880
RECORDING_STARTUP_MEDIA_TIMEOUT_MS=15000
RECORDING_ROTATION_GRACE_MS=5000
RECORDING_STOP_GRACE_MS=20000
RECORDING_MIN_FREE_BYTES=536870912
# RECORDING_SEGMENT_SECONDS bleibt nur als Alt-Konfigurationsfallback erhalten.
# RECORDING_SEGMENT_SECONDS=300
RECORDING_FINALIZE_TIMEOUT_MS=120000
RECORDING_RECONNECT_BASE_MS=1000
RECORDING_RECONNECT_MAX_MS=15000
RECORDING_MAX_OUTAGE_SECONDS=180
RECORDING_MAX_RECONNECT_ATTEMPTS=30
RECORDING_STABLE_RESET_SECONDS=30
RECORDING_WATCHDOG_INTERVAL_MS=2500
RECORDING_STALL_SECONDS=25
RECORDING_SOURCE_PROTOCOL=auto
RECORDING_PREBUFFER_MAX_SECONDS=10
RECORDING_SCHEDULER_INTERVAL_MS=5000
RECORDING_SCHEDULER_CONCURRENCY=4
RECORDING_QUEUE_MAX_PENDING=20

# Serielle Hintergrundkomprimierung abgeschlossener Aufnahmeblöcke
RECORDING_COMPRESSION_ENABLED=true
RECORDING_COMPRESSION_CRF=29
RECORDING_COMPRESSION_MAX_VIDEO_BITRATE_KBPS=2500
RECORDING_COMPRESSION_PRESET=veryfast
RECORDING_COMPRESSION_THREADS=1
# 0 behält die Originalauflösung; z. B. 720 begrenzt auf 720p.
RECORDING_COMPRESSION_MAX_HEIGHT=0
RECORDING_COMPRESSION_AUDIO_BITRATE_KBPS=64
RECORDING_COMPRESSION_MIN_BYTES=5242880
RECORDING_COMPRESSION_MIN_SAVINGS_PERCENT=5
RECORDING_COMPRESSION_MIN_DURATION_RATIO=0.96
RECORDING_COMPRESSION_TIMEOUT_MS=1800000
RECORDING_COMPRESSION_PROBE_TIMEOUT_MS=30000
RECORDING_COMPRESSION_POLL_MS=5000
RECORDING_COMPRESSION_START_DELAY_MS=120000
RECORDING_COMPRESSION_BUSY_DELAY_MS=60000
RECORDING_COMPRESSION_MAX_LOAD_RATIO=0.75
RECORDING_COMPRESSION_IDLE_GRACE_MS=30000
RECORDING_COMPRESSION_RUNTIME_CHECK_MS=2000
RECORDING_COMPRESSION_NICE=15
RECORDING_COMPRESSION_PAUSE_DURING_PTZ=true
RECORDING_COMPRESSION_PAUSE_WHILE_RECORDING=false
RECORDING_COMPRESSION_PAUSE_DURING_STREAM_RECOVERY=true
RECORDING_COMPRESSION_MAX_ATTEMPTS=3
RECORDING_COMPRESSION_RETRY_BASE_MS=60000
RECORDING_COMPRESSION_RETRY_MAX_MS=3600000
RECORDING_COMPRESSION_BACKFILL=true
RECORDING_COMPRESSION_BACKFILL_LIMIT=250
RECORDING_SCHEDULER_IMMEDIATE_DEBOUNCE_MS=250

# PTZ-Steuerung und Automationssperre
# PTZ erzeugt niemals Recording-Events. Neue automatische Aufnahmestarts sind
# waehrend aktiver Bedienung und der Settle-Phase gesperrt; laufende Aufnahmen bleiben aktiv.
PTZ_COMMAND_TIMEOUT_MS=5000
PTZ_CONTINUOUS_MOVE_TIMEOUT_MS=1200
PTZ_LEASE_TTL_MS=2500
PTZ_LEASE_SWEEP_MS=500
PTZ_TOMBSTONE_TTL_MS=15000
PTZ_MAX_LEASES_PER_CAMERA=16
PTZ_CLIENT_IDLE_MS=300000
PTZ_MOTION_SETTLE_MS=2200
PTZ_STREAM_VERIFY_MS=5000
PTZ_LIVE_RESYNC_ENABLED=true
PTZ_LIVE_RESYNC_DELAY_MS=900
PTZ_BROWSER_RESYNC_MS=3500

# Ereignisaufnahme: serverseitige Bewegungserkennung per Bildvergleich
MOTION_DETECTION_ENABLED=true
MOTION_DETECTION_SOURCE=live
MOTION_DETECTION_SNAPSHOT_FALLBACK=false
MOTION_DETECTION_SKIP_DURING_PTZ=true
MOTION_DETECTION_INTERVAL_MS=2000
MOTION_DETECTION_CONCURRENCY=2
MOTION_DETECTION_FRAME_WIDTH=96
MOTION_DETECTION_FRAME_HEIGHT=54
MOTION_DETECTION_FRAME_TIMEOUT_MS=9000
MOTION_DETECTION_BLUR_RADIUS=1
MOTION_DETECTION_STABILIZATION_PIXELS=1
MOTION_DETECTION_BRIGHTNESS_COMPENSATION=true
MOTION_DETECTION_PIXEL_THRESHOLD=10
MOTION_DETECTION_MIN_CHANGED_RATIO=0.008
MOTION_DETECTION_MIN_AVERAGE_DIFF=0.6
MOTION_DETECTION_MIN_CHANGED_PIXELS=18
MOTION_DETECTION_SCENE_CHANGE_RATIO=0.85
MOTION_DETECTION_SCENE_CHANGE_MIN_AVERAGE_DIFF=12
MOTION_DETECTION_SUPPRESS_SCENE_CHANGES=false
MOTION_DETECTION_EVENT_SECONDS=20
MOTION_DETECTION_COOLDOWN_SECONDS=3
MOTION_DETECTION_REARM_SECONDS=3
MOTION_DETECTION_RETRIGGER_SECONDS=12
MOTION_DETECTION_DEBOUNCE_FRAMES=1
MOTION_DETECTION_WINDOW_FRAMES=4
MOTION_DETECTION_WINDOW_MIN_MOTION_FRAMES=1

# Per-camera retention cleanup
RETENTION_CLEANUP_INTERVAL_MS=900000
RETENTION_STARTUP_DELAY_MS=20000
RETENTION_BATCH_SIZE=100
RETENTION_DEFAULT_MAX_AGE_DAYS=30

# Optional administrator webhook (email/push gateway, automation platform)
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=error
ALERT_COOLDOWN_MS=300000
STREAM_STALL_SECONDS=45
STREAM_HARD_STALL_SECONDS=300
STREAM_BROKER_API_GRACE_MS=120000
STREAM_RESTART_INITIAL_DELAY_MS=2500
STREAM_RESTART_JITTER_MS=750
STREAM_BROKER_UNAVAILABLE_RETRY_MS=8000
# copy-first = H.264 zuerst ohne Neukodierung testen; safe = vorsorglich normalisieren; transcode = immer normalisieren.
STREAM_BROWSER_VIDEO_MODE=copy-first
SNAPSHOT_VIDEO_FPS=5
SNAPSHOT_REFRESH_MS=1000
PROBE_TIMEOUT_MS=9000
CAMERA_CONNECT_TIMEOUT_MS=10000
STREAM_START_TIMEOUT_MS=15000
MAX_RESTART_BACKOFF_MS=30000
LOG_LEVEL=info
HTTPS_SITE_ADDRESS=https://camera.local
# auto = NAS-/Host-IP beim Start und beim Update automatisch erkennen; manual = GO2RTC_WEBRTC_CANDIDATE unveraendert lassen.
GO2RTC_WEBRTC_CANDIDATE_MODE=auto
GO2RTC_WEBRTC_CANDIDATE=stun:8189
STREAM_WEBRTC_ENABLED=false
STREAM_BROWSER_TRANSPORT_ORDER=local-hls
HTTP_PORT=8080
HTTPS_PORT=8443
WEBRTC_ICE_PORT=8189

# Interne Updater-Service-Discovery. Für Docker Compose sind diese Standardwerte korrekt.
UPDATER_SERVICE_PROTOCOL=http
UPDATER_SERVICE_NAME=updater
UPDATER_SERVICE_PORT=3010
UPDATER_SERVICE_BASE_PATH=
UPDATER_SOCKET_PATH=/data/updates/tmp-camera-updater.sock

# Optional: explizite Endpunkte mit höherer Priorität, getrennt durch Komma, Semikolon oder Leerzeichen.
# Beispiel: UPDATER_URLS=http://updater:3010,http://tmp-camera-updater:3010
UPDATER_URLS=
# Kompatibilitätswert für ältere Installationen; im Normalbetrieb leer lassen.
UPDATER_URL=

# Optionale Ausweichziele, erst nach Service Discovery verwendet.
# Ein Host-Fallback ist nur sinnvoll, wenn dort tatsächlich ein Updater veröffentlicht wird.
UPDATER_FALLBACK_URLS=http://tmp-camera-updater:3010
UPDATER_FALLBACK_URL=

# Zeitlimits und begrenzte Wiederholungen für Health- und Installationsanfragen.
UPDATER_HEALTH_TIMEOUT_MS=15000
UPDATER_REQUEST_TIMEOUT_MS=15000
UPDATER_HEALTH_RETRIES=1
UPDATER_REQUEST_RETRIES=1
UPDATER_RETRY_DELAY_MS=250
UPDATER_RESTART_GRACE_MS=300000
UPDATER_IDEMPOTENCY_TTL_MS=900000

# Interne Healthziele, die der Updater nach Installation bzw. Rollback prüft.
BACKEND_HEALTH_URL=http://backend:3000/health
FRONTEND_HEALTH_URL=http://frontend:8080/healthz

# Dauerhafte, manuell verwaltete LAN-/VPN-/VLAN-Netze. start.sh überschreibt diesen Wert nicht.
HOST_SCAN_RANGES=192.168.1.0/24

# Wird bei jedem Start aus echten Interface-/VPN-Netzen neu ermittelt und mit HOST_SCAN_RANGES kombiniert.
# /32-Hostrouten werden automatisch entfernt, wenn sie bereits in einem größeren Netz liegen.
AUTO_HOST_SCAN_RANGES=


# Oberfläche, Sprache und öffentliche Produktlinks (werden beim Frontend-Build eingebettet)
# auto = Browsersprache verwenden, sonst z. B. de, en, fr, es oder ar.
VITE_DEFAULT_LANGUAGE=auto
VITE_VENDOR_URL=https://tmp-networks.de
VITE_SUPPORT_URL=
VITE_DOCUMENTATION_URL=

# Keine versteckten Browserdecoder fuer alle Kameras offen halten; der Backend-Ingest uebernimmt das Vorwaermen.
# Neuer Name, damit ein alter v2.18.0-Wert VITE_STREAM_ALWAYS_ON=true das Upgrade nicht aushebelt.
VITE_STREAM_BROWSER_PREWARM_ENABLED=false
VITE_BROWSER_TRANSCODE_FALLBACK_ENABLED=false
VITE_STREAM_PLAYBACK_ORDER=local-hls
VITE_STREAM_BROWSER_CACHE_SECONDS=120
VITE_STREAM_BROWSER_STALL_SECONDS=30
VITE_HLS_RECOVERY_ESCALATION_SECONDS=10
# Browserplayer verwendet den stabilen v2.16.3-WebRTC-first-Pfad mit LL-HLS-Ersatz.
VITE_STREAM_HLS_START_TIMEOUT_SECONDS=25
VITE_STREAM_WEBRTC_START_TIMEOUT_SECONDS=8

# Docker/Compose-Ausfuehrung im read-only Updater-Container
COMPOSE_BAKE=false
DOCKER_BUILDKIT=1

# Echtzeit-Ereignisse, WebSocket und Audit
WEBSOCKET_ALLOWED_ORIGINS=
WEBSOCKET_MAX_CLIENTS=128
WEBSOCKET_MAX_MESSAGE_BYTES=16384
WEBSOCKET_HEARTBEAT_MS=20000
WEBSOCKET_MAX_BUFFERED_BYTES=1048576
AUDIT_LOG_RETENTION_DAYS=180
DOMAIN_EVENT_QUEUE_LIMIT=2000

# Docker-Kompatibilitaet
COMPOSE_BAKE=false
DOCKER_BUILDKIT=0
COMPOSE_DOCKER_CLI_BUILD=0
FORCE_IMAGE_PULL=false
UPDATER_DOCKER_CACHE_CLEANUP=true
UPDATER_OPTIONAL=true

# Browser playback uses the backend-maintained local HLS ring. Set to go2rtc for diagnostics only.
STREAM_BROWSER_HLS_MODE=local-ring
LOCAL_HLS_DIR=/data/live
PUBLIC_LOCAL_HLS_BASE=/live-hls

# The active FFmpeg recording spool stays local. SMB/CIFS and SFTP targets are
# configured from Recordings -> Storage in the web interface.
RECORDINGS_DIR=/data/recordings
RECORDINGS_LOCAL_DIR=/data/recordings
NETWORK_RECORDING_CACHE_MAX_BYTES=2147483648
NETWORK_RECORDING_UPLOAD_INTERVAL_MS=15000
NETWORK_RECORDING_COMMAND_TIMEOUT_MS=30000
NETWORK_RECORDING_STALE_PART_MAX_AGE_MS=3600000
